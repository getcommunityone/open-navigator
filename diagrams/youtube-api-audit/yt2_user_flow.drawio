<mxfile host="app.diagrams.net" agent="open-navigator youtube-api-audit"><diagram name="yt2_user_flow"><mxGraphModel dx="1600" dy="1500" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1480" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="User flow: citizen watches a meeting recording on CommunityOne (YouTube embed; no upload)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Standard flowchart shapes. Journey never includes YouTube OAuth or CommunityOne uploading video." style="text;html=1;fontSize=12;align=left;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1400" height="28" as="geometry"/></mxCell><mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fontColor=#111827;strokeColor=#111827;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="590" y="80" width="120" height="48" as="geometry"/></mxCell><mxCell id="home" value="Homepage · communityone.com&lt;br&gt;Search place / topic / meeting" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#111827;strokeColor=#111827;strokeWidth=1.5;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="160" width="280" height="72" as="geometry"/></mxCell><mxCell id="results" value="Browse / search results&lt;br&gt;Pick a meeting" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#111827;strokeColor=#111827;strokeWidth=1.5;fillColor=#ffffff;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="270" width="280" height="64" as="geometry"/></mxCell><mxCell id="meeting" value="Meeting page&lt;br&gt;title · date · board · money discussed" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#111827;strokeColor=#1118