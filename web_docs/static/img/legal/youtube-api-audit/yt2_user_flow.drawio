<mxfile host="app.diagrams.net" agent="open-navigator youtube-api-audit build_drawio.py"><diagram name="yt2_user_flow"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="640" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="CommunityOne — user flow for meeting recordings (YouTube embed; no upload)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Citizens never grant YouTube OAuth to CommunityOne. They watch public meeting video on YouTube (embedded player or Open on YouTube). CommunityOne does not upload video to YouTube." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1520" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Citizen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="34" as="geometry"/></mxCell><mxCell id="c4" value="communityone.com" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="420" height="34" as="geometry"/></mxCell><mxCell id="c5" value="YouTube" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="360" height="34" as="geometry"/></mxCell><mxCell id="c6" value="Out of scope" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="380" height="34" as="geometry"/></mxCell><mxCell id="u1" value="1. Open Open Navigator&lt;br&gt;Search place / meeting / topic" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#354F52;strokeWidth=2;fillColor=#E8F0F1;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="260" height="70" as="geometry"/></mxCell><mxCell id="u2" value="2. Open a meeting page&lt;br&gt;with a linked recording" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#354F52;strokeWidth=2;fillColor=#E8F0F1;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="260" height="70" as="geometry"/></mxCell><mxCell id="u3" value="3. Watch in-page player&lt;br&gt;or click Open on YouTube" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#354F52;strokeWidth=2;fillColor=#E8F0F1;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="260" height="70" as="geometry"/></mxCell><mxCell id="u4" value="4. Optionally read Privacy §9&lt;br&gt;/ Terms (YouTube API notices)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#15803D;strokeWidth=2;fillColor=#DCFCE7;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="260" height="70" as="geometry"/></mxCell><mxCell id="a1" value="Web app loads meeting&lt;br&gt;from public API / warehouse" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#354F52;strokeWidth=2;fillColor=#E8F0F1;" vertex="1" parent="1"><mxGeometry x="390" y="180" width="360" height="70" as="geometry"/></mxCell><mxCell id="a2" value="Shows title, date, board&lt;br&gt;+ YouTube video_id metadata" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#354F52;strokeWidth=2;fillColor=#E8F0F1;" vertex="1" parent="1"><mxGeometry x="390" y="290" width="360" height="70" as="geometry"/></mxCell><mxCell id="a3" value="Renders youtube.com embed&lt;br&gt;+ Watch / Open on YouTube link" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#354F52;strokeWidth=2;fillColor=#E8F0F1;" vertex="1" parent="1"><mxGeometry x="390" y="400" width="360" height="70" as="geometry"/></mxCell><mxCell id="a4" value="Docs site: Privacy Policy §9&lt;br&gt;Terms → YouTube ToS acknowledgment" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#15803D;strokeWidth=2;fillColor=#DCFCE7;" vertex="1" parent="1"><mxGeometry x="390" y="510" width="360" height="70" as="geometry"/></mxCell><mxCell id="y1" value="Public video / channel&lt;br&gt;already published by the city" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#7D8998;strokeWidth=2;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="820" y="200" width="320" height="80" as="geometry"/></mxCell><mxCell id="y2" value="YouTube player serves stream&lt;br&gt;(user stays under YouTube ToS)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#7D8998;strokeWidth=2;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="320" height="80" as="geometry"/></mxCell><mxCell id="y3" value="Google Privacy Policy applies&lt;br&gt;to YouTube playback" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#1E3A5F;strokeWidth=2;fillColor=#DBEAFE;" vertex="1" parent="1"><mxGeometry x="820" y="470" width="320" height="70" as="geometry"/></mxCell><mxCell id="x1" value="CommunityOne does NOT&lt;br&gt;upload videos to YouTube" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#B91C1C;strokeWidth=2;fillColor=#FEE2E2;" vertex="1" parent="1"><mxGeometry x="1200" y="220" width="340" height="80" as="geometry"/></mxCell><mxCell id="x2" value="No YouTube write APIs&lt;br&gt;No Authorized Data access" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#B91C1C;strokeWidth=2;fillColor=#FEE2E2;" vertex="1" parent="1"><mxGeometry x="1200" y="340" width="340" height="80" as="geometry"/></mxCell><m